# Puertos del host para docker compose (este .env de la raiz lo lee compose para
# interpolar docker-compose.yml; la configuracion de la aplicacion va en backend/.env).
# Cambialos si otro proyecto ya ocupa alguno. Dentro de la red de compose los servicios
# se siguen hablando por su puerto interno, asi que nada mas hay que tocar.
TIMU_API_PORT=8000
TIMU_WEB_PORT=5173
TIMU_DB_PORT=5432
# PgBouncer: la aplicacion pasa por aqui. Solo hace falta en el host para depurar el pool.
TIMU_PGBOUNCER_PORT=6432
TIMU_REDIS_PORT=6379
TIMU_S3_PORT=9000

# Prueba de carga (perfil `carga`, ver CLAUDE.md): usuarios simultaneos y duracion de k6.
# CARGA_VUS=20
# CARGA_DURACION=5m
