# --- App ---
# local | test | staging | production. En staging y production el servicio no arranca
# si falta una variable obligatoria o si queda un valor de desarrollo (ver app/core/config.py).
APP_NAME=TIMU Plataforma
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=cambiar-en-produccion-solo-para-desarrollo-local
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Sesion (F1-AUT-01): access token corto que sostiene una cookie de renovacion ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_RECUPERACION_MINUTOS=30
TOKEN_ACTIVACION_HORAS=72

# --- Sesion del navegador: cookies httpOnly (COOKIE_SECURE=true bajo HTTPS) ---
COOKIE_NAME=timu_sesion
COOKIE_REFRESH_NAME=timu_renovacion
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Endurecimiento HTTP (F0-06) ---
RATE_LIMIT_POR_MINUTO=120
RATE_LIMIT_LOGIN_POR_MINUTO=10
MAX_TAMANO_CARGA_MB=10

# --- PostgreSQL (6.x: integridad referencial familias/mascotas/planes/pagos/HC) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Dueno del esquema: lo usan las migraciones y `inicializar`, nunca la aplicacion.
POSTGRES_USER=timu
POSTGRES_PASSWORD=timu
POSTGRES_DB=timu
# Clave del rol timu_app, con el que se conectan API, workers y scripts: sin
# superusuario ni BYPASSRLS, asi que la base le aplica sus politicas.
APP_DB_PASSWORD=timu_app
# Host y puerto por los que la aplicacion llega a la base. Vacios: los de POSTGRES_*. En
# compose, api, worker y beat pasan por PgBouncer (lo fija el propio compose).
APP_DB_HOST=
APP_DB_PORT=

# --- Celery / Redis (automatizaciones: recordatorios, preventivos, encuestas) ---
REDIS_URL=redis://redis:6379/0

# --- WhatsApp: Meta Cloud API oficial (6.19) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=timu-verify
WHATSAPP_API_VERSION=v21.0
# Secreto de la app de Meta: firma X-Hub-Signature-256 de los webhooks.
WHATSAPP_APP_SECRET=

# --- Pasarela de pagos (Wompi / PayU) ---
PAYMENTS_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1

# --- Cartera (F1-CAR) ---
CUOTA_EMISION_DIAS_ANTES=5
COBRO_RECURRENTE_REINTENTOS_DIAS=[0, 3, 7]

# --- Google Maps Platform (6.7 rutas, F1-FAM-05 geocodificacion) ---
GOOGLE_MAPS_API_KEY=

# --- Almacenamiento de adjuntos, compatible S3 (F0-11) ---
# En desarrollo apunta al SeaweedFS del compose, que toma estas mismas credenciales. Con el
# bucket del cliente: dejar STORAGE_ENDPOINT_URL vacio para AWS S3 y rellenar region,
# bucket y credenciales.
STORAGE_ENDPOINT_URL=http://almacenamiento:8333
# Host con el que el navegador abre las URL firmadas, si difiere del anterior. En docker
# compose lo fija el propio compose (localhost:TIMU_S3_PORT); con S3 real, vacio.
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=timu-adjuntos
STORAGE_ACCESS_KEY=timu-local
STORAGE_SECRET_KEY=timu-local-secreto
STORAGE_URL_TTL_SEGUNDOS=300

# --- Respaldos (F0-07): bucket distinto al de adjuntos. Vacio = solo copia local ---
RESPALDO_BUCKET=

# --- Correo saliente (recuperacion de clave). Vacio = solo se registra en el log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TIMU <no-responder@timu.co>

# Clave del administrador inicial (scripts.seed). Vacia en local: usa cambiar123.
# En staging y produccion el seed se niega sin ella (12 caracteres o mas).
ADMIN_PASSWORD_INICIAL=

# --- Observabilidad (F0-08). Sin DSN, Sentry queda desactivado ---
SENTRY_DSN=
LOG_JSON=false
