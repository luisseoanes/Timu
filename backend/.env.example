# --- App ---
APP_NAME=TIMU Plataforma
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (6.x: integridad referencial familias/mascotas/planes/pagos/HC) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=timu
POSTGRES_PASSWORD=timu
POSTGRES_DB=timu

# --- Celery / Redis (automatizaciones: recordatorios, preventivos, encuestas) ---
REDIS_URL=redis://redis:6379/0

# --- WhatsApp: Meta Cloud API oficial (6.19) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=timu-verify
WHATSAPP_API_VERSION=v21.0

# --- Pasarela de pagos (Wompi / PayU) ---
PAYMENTS_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# --- Google Maps Platform (6.7 optimizacion de rutas) ---
GOOGLE_MAPS_API_KEY=

# --- Sesion del navegador: cookie httpOnly (poner COOKIE_SECURE=true bajo HTTPS) ---
COOKIE_NAME=timu_sesion
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Almacenamiento de adjuntos, compatible S3 (F0-11) ---
# En desarrollo apunta a MinIO. Con el bucket del cliente: dejar STORAGE_ENDPOINT_URL
# vacio para AWS S3 y rellenar region, bucket y credenciales.
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=timu-adjuntos
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_URL_TTL_SEGUNDOS=300

# --- Observabilidad (F0-08). Sin DSN, Sentry queda desactivado ---
SENTRY_DSN=
LOG_JSON=false
