# --- App ---
APP_NAME=TIMU Plataforma
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (6.x: integridad referencial familias/mascotas/planes/pagos/HC) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=timu
POSTGRES_PASSWORD=timu
POSTGRES_DB=timu

# --- Celery / Redis (automatizaciones: recordatorios, preventivos, encuestas) ---
REDIS_URL=redis://redis:6379/0

# --- WhatsApp: Meta Cloud API oficial (6.19) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=timu-verify
WHATSAPP_API_VERSION=v21.0

# --- Pasarela de pagos (Wompi / PayU) ---
PAYMENTS_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# --- Google Maps Platform (6.7 optimizacion de rutas) ---
GOOGLE_MAPS_API_KEY=
