# Servidor del panel compilado (Dockerfile.despliegue). Variables:
#   PORT         puerto en el que escucha (lo pone Railway; en staging, 5173, al que apunta
#                el dominio público de `web`).
#   API_INTERNA  dirección de la API por la red privada (http://api.railway.internal:8000).
{
	admin off
	# El TLS lo termina el borde de Railway: aquí se escucha en HTTP.
	auto_https off
	servers {
		# Railway entra por su borde: se conserva el X-Forwarded-For que trae, para que los
		# límites por IP de la API vean a quien llega y no al borde.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_INTERNA}
	}

	handle {
		root * /srv
		# Los recursos de Vite llevan su huella en el nombre; el resto (index.html y las rutas
		# del panel, que lo sirven) se revalida para que un despliegue se vea al recargar.
		@recursos path /assets/*
		header @recursos Cache-Control "public, max-age=31536000, immutable"
		@paginas not path /assets/*
		header @paginas Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
